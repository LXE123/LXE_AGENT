# Non-sensitive, machine-specific overrides only.
# Copy only the settings you need to .env.local; shared defaults live in config/runtime.env.

# Local diagnostics. Production defaults keep local file logging disabled.
LOCAL_LOGS_ENABLED=1

# Data Server development connection. Packaged builds ignore these source settings.
LXE_DATA_SERVER_ENABLED=1
LXE_DATA_SERVER_URL=http://10.88.0.1:8000
LXE_DATA_SERVER_LOCAL_FALLBACK_ENABLED=1
LXE_DATA_SERVER_FALLBACK_URL=http://127.0.0.1:8000

# Optional model override
AGENT_LLM_THINKING_EFFORT=low

# Machine-specific Ziniao installation
# macOS:
ZINIAO_CLIENT_PATH=/Applications/ziniao.app/Contents/MacOS/ziniao
ZINIAO_WEBDRIVER_PATH=/Users/your-name/.cache/ziniao/webdriver
# Windows example:
# ZINIAO_CLIENT_PATH=D:\ziniao\ziniao.exe
# ZINIAO_WEBDRIVER_PATH=D:\webdriver
