# Developer-only local diagnostics. Copy the settings you need to .env.local.
# Production defaults keep local file logging disabled.
LOCAL_LOGS_ENABLED=1
LOG_FILE=runtime.log
RUNTIME_LOG_LEVEL=DEBUG

# Developer-only data server fallback. Packaged builds always ignore this fallback.
LXE_DATA_SERVER_ENABLED=1
LXE_DATA_SERVER_URL=http://10.88.0.1:8000
LXE_DATA_SERVER_SYNC_INTERVAL_SECONDS=3600
LXE_DATA_SERVER_LOCAL_FALLBACK_ENABLED=1
LXE_DATA_SERVER_FALLBACK_URL=http://127.0.0.1:8000
