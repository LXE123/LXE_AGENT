# Development integration credentials only. Desktop installations use encrypted secrets.bin.
# Non-sensitive settings belong to var/config/settings.json.
# User-owned model credentials belong to var/config/auth.json.

# Feishu bot secret
# Required app scopes include im:message.reactions:write_only for Typing indicators.
FEISHU_APP_SECRET=

# Mabang password
MABANG_PASSWORD=
LXE_YACANG_PASSWORD=

# Ziniao password
ZINIAO_PASSWORD=

# Legacy credential compatibility only; native company calls do not use these keys.
LXE_DATA_SERVER_API_KEY=
LXE_ERP_API_KEY=

# Legacy custom MCP configurations only; managed Saihu MCP uses device authentication.
LXE_SAIHU_MCP_API_KEY=

# 上马 ERP 登录（开发环境；生产桌面请在设置中配置）
LXE_SHANGMAN_PROCESSED_PASSWORD=
