# Project credentials and private identity only.
# Copy to .env and fill only the credentials used on this machine.

# LLM auth profiles
DEEPSEEK_API=
KIMI_CODE_API_KEY=
GLM_API_KEY=

# Feishu bot
# Required app scopes include im:message.reactions:write_only for Typing indicators.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Mabang login profiles
MABANG_ACCOUNT=
MABANG_PASSWORD=

# Ziniao login profile
ZINIAO_COMPANY=
ZINIAO_USERNAME=
ZINIAO_PASSWORD=
# Ziniao runtime defaults live in config/runtime.env.

# Gateway private identity
GATEWAY_ID=

# Data server auth
LXE_DATA_SERVER_API_KEY=
LXE_DATA_SERVER_FALLBACK_API_KEY=
