# Development integration credentials only. Desktop installations use encrypted secrets.bin.
# Non-sensitive settings belong to var/config/settings.json.
# User-owned model credentials belong to var/config/auth.json.

# Feishu bot secret
# Required app scopes include im:message.reactions:write_only for Typing indicators.
FEISHU_APP_SECRET=

# Mabang password
MABANG_PASSWORD=

# Ziniao password
ZINIAO_PASSWORD=

# Data server auth
LXE_DATA_SERVER_API_KEY=
LXE_DATA_SERVER_FALLBACK_API_KEY=
LXE_ERP_API_KEY=

# Developer-only Saihu MCP gateway credential. Never reuse the Data Server key.
LXE_SAIHU_MCP_API_KEY=
