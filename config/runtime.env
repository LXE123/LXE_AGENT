# Local file logs and diagnostic dumps
# Set to 1 to enable writes under var/logs/. Console logs stay enabled.
LOCAL_LOGS_ENABLED=0
LOCAL_LOG_RETENTION_DAYS=7
FEISHU_RAW_EVENT_DUMP_ENABLED=1

# Console/runtime logging
LOG_LEVEL=INFO
RUNTIME_LOG_LEVEL=DEBUG
LOG_LEVELS=

# Feishu gateway runtime
# Set the gateway to 0 only for energy diagnostics; normal runtime keeps it enabled.
LXE_FEISHU_GATEWAY_ENABLED=1

# Mabang artifact directories
MABANG_STOCK_SKU_EXPORT_DIR=
MABANG_FBA_STORE_RESOLVER_OUTPUT_DIR=
MABANG_STORE_MSKU_OUTPUT_DIR=
MABANG_STORE_MSKU_ANALYSIS_OUTPUT_DIR=
MABANG_STORE_MSKU_INVENTORY_OUTPUT_DIR=
MABANG_STORE_MSKU_REPLENISHMENT_OUTPUT_DIR=
MABANG_FBA_UNLINKED_SHIPMENTS_OUTPUT_DIR=
MABANG_MSKU_DETAIL_OUTPUT_DIR=
FBA_DELIVERY_CSV_DIR=

# Ziniao machine settings
ZINIAO_REGISTER_PLANNER_TOOLS=1
# Official legacy WebDriver client path formats:
#   Windows v6: D:\ziniao\ziniao.exe
#   macOS executable: /Applications/ziniao.app/Contents/MacOS/ziniao
#   macOS app name fallback: ziniao
#   Linux: /opt/ziniao/ziniaobrowser
ZINIAO_CLIENT_PATH=
# Required on Windows/macOS. Leave empty on Linux; the client uses its embedded driver.
ZINIAO_WEBDRIVER_PATH=
ZINIAO_BROWSER_VERSION=v6
# Optional local JSONL diagnostics for legacy Ziniao store/session/Selenium issues.
ZINIAO_DIAGNOSTIC_TRACE_ENABLED=1

# Browser auth and WMS export
BROWSER_AUTH_HEADLESS=1

# Data server upload
LXE_DATA_SERVER_ENABLED=0
LXE_DATA_SERVER_URL=
LXE_DATA_SERVER_LOCAL_FALLBACK_ENABLED=0
LXE_DATA_SERVER_FALLBACK_URL=

# Agent LLM runtime selection
AGENT_LLM_PROVIDER=kimi_coding
AGENT_LLM_MODEL=kimi-for-coding
AGENT_LLM_THINKING_ENABLED=1
AGENT_LLM_THINKING_EFFORT=high

# Agent stream and trace diagnostics
AGENT_SSE_WIRE_TRACE_ENABLED=1
