# Local file logs and diagnostic dumps
# Set to 1 to enable writes under var/logs/. Console logs stay enabled.
LOCAL_LOGS_ENABLED=0
LOCAL_LOG_RETENTION_DAYS=7
FEISHU_RAW_EVENT_DUMP_ENABLED=1
FEISHU_RAW_EVENT_DUMP_DIR=var/logs/feishu_raw_events

# Console/runtime logging
LOG_LEVEL=INFO
RUNTIME_LOG_LEVEL=DEBUG
LOG_LEVELS=
LOG_FORMAT=text
# Terminal rendering for the Bun gateway: pretty (human-readable, default) or json.
# The runtime log file always stays JSONL regardless of this setting.
LOG_CONSOLE_FORMAT=pretty
# Shared basename: Bun writes JSONL to var/logs/runtime/<day>/runtime.log,
# Python processes write text to var/logs/runtime/<day>/runtime-py.log.
LOG_FILE=runtime.log
BROWSER_AUTH_LOG_FILE=browser_auth_service.log

# Mabang artifact directories
MABANG_STOCK_SKU_EXPORT_DIR=
MABANG_FBA_STORE_RESOLVER_OUTPUT_DIR=
MABANG_STORE_MSKU_OUTPUT_DIR=
MABANG_STORE_MSKU_ANALYSIS_OUTPUT_DIR=
MABANG_STORE_MSKU_INVENTORY_OUTPUT_DIR=
MABANG_STORE_MSKU_REPLENISHMENT_OUTPUT_DIR=
MABANG_FBA_UNLINKED_SHIPMENTS_OUTPUT_DIR=
MABANG_MSKU_DETAIL_OUTPUT_DIR=
FBA_DELIVERY_CSV_DIR=

# Ziniao machine settings
ZINIAO_REGISTER_PLANNER_TOOLS=1
# Official legacy WebDriver client path formats:
#   Windows v6: D:\ziniao\ziniao.exe
#   macOS executable: /Applications/ziniao.app/Contents/MacOS/ziniao
#   macOS app name fallback: ziniao
#   Linux: /opt/ziniao/ziniaobrowser
ZINIAO_CLIENT_PATH=
# Required on Windows/macOS. Leave empty on Linux; the client uses its embedded driver.
ZINIAO_WEBDRIVER_PATH=
ZINIAO_BROWSER_VERSION=v6
ZINIAO_SOCKET_PORT=16851
# Optional local JSONL diagnostics for legacy Ziniao store/session/Selenium issues.
ZINIAO_DIAGNOSTIC_TRACE_ENABLED=1
ZINIAO_DIAGNOSTIC_TRACE_DIR=var/logs/ziniao_traces

# Browser auth and WMS export
BROWSER_AUTH_HEADLESS=1
FBA_LOGISTICS_TOKEN_HEADLESS=1
BROWSER_AUTH_LOCK_TIMEOUT_SECONDS=180
BROWSER_AUTH_FORCE_COOLDOWN_SECONDS=30
FBA_LOGISTICS_WMS_EXPORT_RETRY=1

# Gateway runtime
AGENT_MAX_CONCURRENCY=2
LXE_MAINTENANCE_AUTH_ENABLED=1

# Data server upload
LXE_DATA_SERVER_ENABLED=0
LXE_DATA_SERVER_URL=
LXE_DATA_SERVER_SYNC_INTERVAL_SECONDS=10800
LXE_DATA_SERVER_REQUEST_TIMEOUT_SECONDS=30
LXE_DATA_SERVER_SESSION_LIMIT=1000

# Agent LLM runtime selection
AGENT_LLM_PROVIDER=kimi_coding
AGENT_LLM_MODEL=kimi-for-coding
AGENT_LLM_MAX_TOKENS=0
AGENT_LLM_THINKING_ENABLED=1
AGENT_LLM_THINKING_EFFORT=medium
AGENT_LLM_THINKING_DISPLAY=omitted
# Maximum silence between Provider connection/stream events, not a total turn duration.
LLM_REQUEST_TIMEOUT_S=120

# Agent stream and trace diagnostics
AGENT_STREAM_LOG_MODE=summary
AGENT_STREAM_TRACE_ENABLED=1
AGENT_STREAM_HEARTBEAT_MS=1000
AGENT_STREAM_HEARTBEAT_CHARS=300
AGENT_STREAM_DEBUG_PREVIEW_CHARS=80
AGENT_STREAM_TRACE_DIR=var/logs/agent_traces
AGENT_SSE_WIRE_TRACE_ENABLED=1
AGENT_SSE_WIRE_TRACE_DIR=var/logs/sse_wire_traces
