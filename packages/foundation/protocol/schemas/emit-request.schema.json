{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lxe-agent.local/protocol/emit-request.schema.json",
  "title": "EmitRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "turn_id",
    "response_route_id",
    "content",
    "thinking",
    "redacted_thinking_count",
    "thinking_elapsed_ms",
    "tool_pending",
    "tool_elapsed_ms",
    "tool_steps",
    "files",
    "emit_kind",
    "emit_id",
    "stream_type",
    "state",
    "seq"
  ],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1 },
    "response_route_id": { "type": "string" },
    "content": { "type": "string" },
    "thinking": { "type": "string" },
    "redacted_thinking_count": { "type": "integer", "minimum": 0 },
    "thinking_elapsed_ms": { "type": "integer", "minimum": 0 },
    "tool_pending": { "type": "boolean" },
    "tool_elapsed_ms": { "type": "integer", "minimum": 0 },
    "tool_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "title", "detail", "icon_token", "status", "duration_ms"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "icon_token": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["running", "success", "error"]
          },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "result_block": { "$ref": "#/$defs/toolDisplayBlock" },
          "error_block": { "$ref": "#/$defs/toolDisplayBlock" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "emit_kind": { "enum": ["final", "tool", "progress", "stream"] },
    "emit_id": { "type": "string" },
    "stream_type": { "type": "string" },
    "state": { "type": "string" },
    "seq": { "type": "integer", "minimum": 0 },
    "display_metrics": { "$ref": "#/$defs/displayMetrics" }
  },
  "$defs": {
    "toolDisplayBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "content"],
      "properties": {
        "language": { "enum": ["json", "text"] },
        "content": { "type": "string" }
      }
    },
    "displayMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "phase", "elapsed_ms", "model", "input_tokens", "output_tokens",
        "cache_read_input_tokens", "cache_creation_input_tokens", "context_tokens", "context_window_tokens"
      ],
      "properties": {
        "status": { "enum": ["running", "completed", "error", "cancelled"] },
        "phase": {
          "enum": ["preparing_context", "waiting_model", "thinking", "running_tool", "generating_answer"]
        },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "model": { "type": "string" },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_input_tokens": { "type": "integer", "minimum": 0 },
        "context_tokens": { "type": "integer", "minimum": 0 },
        "context_window_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "emit_kind": { "const": "stream" } },
        "required": ["emit_kind"]
      },
      "then": {
        "required": ["display_metrics"],
        "properties": {
          "display_metrics": { "$ref": "#/$defs/displayMetrics" },
          "stream_type": { "const": "final_answer" },
          "state": { "enum": ["delta", "final", "error"] },
          "seq": { "type": "integer", "minimum": 1 }
        }
      },
      "else": {
        "properties": {
          "display_metrics": false,
          "stream_type": { "const": "" },
          "state": { "const": "" },
          "seq": { "const": 0 }
        }
      }
    }
  ]
}
