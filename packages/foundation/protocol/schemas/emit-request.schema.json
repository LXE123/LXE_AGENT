{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lxe-agent.local/protocol/emit-request.schema.json",
  "title": "EmitRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "turn_id",
    "response_route_id",
    "content",
    "thinking",
    "redacted_thinking_count",
    "thinking_elapsed_ms",
    "tool_pending",
    "tool_elapsed_ms",
    "tool_steps",
    "files",
    "emit_kind",
    "emit_id",
    "stream_type",
    "state",
    "seq"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "response_route_id": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "thinking": {
      "type": "string"
    },
    "redacted_thinking_count": {
      "type": "integer",
      "minimum": 0
    },
    "thinking_elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "tool_pending": {
      "type": "boolean"
    },
    "tool_elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "tool_steps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ToolStep"
      }
    },
    "process_parts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/TurnProcessPart"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "emit_kind": {
      "enum": [
        "final",
        "tool",
        "progress",
        "stream"
      ]
    },
    "emit_id": {
      "type": "string"
    },
    "stream_type": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "display_metrics": {
      "$ref": "common.schema.json#/$defs/DisplayMetrics"
    }
  },
  "oneOf": [
    {
      "required": [
        "emit_kind",
        "stream_type",
        "state",
        "seq",
        "display_metrics",
        "process_parts"
      ],
      "properties": {
        "display_metrics": {
          "$ref": "common.schema.json#/$defs/DisplayMetrics"
        },
        "process_parts": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/TurnProcessPart"
          }
        },
        "stream_type": {
          "const": "final_answer"
        },
        "state": {
          "enum": [
            "delta",
            "final",
            "error"
          ]
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "emit_kind": {
          "const": "stream"
        }
      }
    },
    {
      "properties": {
        "display_metrics": false,
        "process_parts": false,
        "stream_type": {
          "const": ""
        },
        "state": {
          "const": ""
        },
        "seq": {
          "const": 0
        },
        "emit_kind": {
          "enum": [
            "final",
            "tool",
            "progress"
          ]
        }
      },
      "required": [
        "emit_kind",
        "stream_type",
        "state",
        "seq"
      ]
    }
  ]
}
