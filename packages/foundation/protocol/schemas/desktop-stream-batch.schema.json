{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lxe-agent.local/protocol/desktop-stream-batch.schema.json",
  "title": "DesktopStreamBatchRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "turn_id",
    "response_route_id",
    "emit_id",
    "seq",
    "mutations"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "response_route_id": {
      "type": "string",
      "minLength": 1
    },
    "emit_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/DesktopStreamMutation"
      }
    }
  }
}
