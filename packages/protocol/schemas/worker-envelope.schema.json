{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lxe-agent.local/protocol/worker-envelope.schema.json",
  "title": "WorkerEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "message_id",
    "reply_to",
    "run_id",
    "seq",
    "kind",
    "payload"
  ],
  "properties": {
    "protocol_version": { "const": "1" },
    "message_id": { "type": "string", "minLength": 1 },
    "reply_to": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "run_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "seq": { "type": "integer", "minimum": 0 },
    "kind": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
