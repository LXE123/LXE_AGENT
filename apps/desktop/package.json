{
  "name": "@lxe/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "bun scripts/build-desktop.ts",
    "dev": "bun run build && bun src/dev.ts",
    "preview": "bun run build && bun src/preview.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test",
    "pack:win": "electron-builder --config ../../build/desktop-publish/electron-builder.json --dir --x64 --config.directories.output=../../dist/desktop-unpacked",
    "dist:win": "electron-builder --config ../../build/desktop-publish/electron-builder.json --win nsis --x64"
  },
  "dependencies": {
    "@lxe/core": "workspace:*",
    "@lxe/desktop-protocol": "workspace:*",
    "@lxe/gateway": "workspace:*",
    "@lxe/protocol": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "electron-updater": "6.6.2",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "24.10.1",
    "electron": "43.7.0",
    "electron-builder": "26.0.12",
    "typescript": "7.0.2"
  }
}
