{
  "name": "@lxe/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./agent-service": "./src/orchestration/agent-service.ts",
    "./desktop": "./src/desktop.ts"
  },
  "scripts": {
    "dev": "bun src/main.ts",
    "watch": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "stop": "bun src/main.ts stop",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.70.0",
    "@lxe/core": "workspace:*",
    "@lxe/desktop-protocol": "workspace:*",
    "@lxe/protocol": "workspace:*",
    "@lxe/runtime": "workspace:*",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  }
}
