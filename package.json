{
  "name": "lxe-agent-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "workspaces": [
    "apps/gateway",
    "packages/protocol",
    "web/agent-dashboard"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "dashboard:build": "bun run --cwd web/agent-dashboard build",
    "gateway:dev": "bun run --cwd apps/gateway dev",
    "gateway:build": "bun run --cwd apps/gateway build",
    "verify": "bun run typecheck && bun run test && bun run dashboard:build && bun run gateway:build"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
