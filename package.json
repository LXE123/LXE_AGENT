{
  "name": "lxe-agent-workspace",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "workspaces": [
    "apps/agent-cli",
    "apps/desktop",
    "apps/gateway",
    "apps/dashboard",
    "packages/foundation/core",
    "packages/foundation/desktop-protocol",
    "packages/foundation/protocol",
    "packages/agent/runtime"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "test:py-tools": "uv run --frozen pytest -q python/lxeskill_cli/tests skills",
    "dashboard:build": "bun run --cwd apps/dashboard build",
    "cds:preview": "bun scripts/cds-gallery.ts preview",
    "cds:check": "bun scripts/cds-gallery.ts check",
    "cds:docs": "bun scripts/cds-gallery.ts docs",
    "agent-cli:build": "bun run --cwd apps/agent-cli build",
    "agent-cli:compile": "bun run --cwd apps/agent-cli compile",
    "desktop:prepare": "bun scripts/prepare-desktop-source.ts",
    "desktop:dev": "bun run desktop:prepare && bun run --cwd apps/desktop dev",
    "desktop:preview": "bun run desktop:prepare && bun run dashboard:build && bun run --cwd apps/desktop preview",
    "desktop:build": "bun run dashboard:build && bun run --cwd apps/desktop build",
    "desktop:runtime:win": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-desktop-runtime.ps1",
    "desktop:tools:mac": "bun scripts/prepare-desktop-macos-exiftool.ts && bun run desktop:tools:fd && bun run office:prepare",
    "desktop:tools:fd": "bun scripts/prepare-desktop-fd.ts",
    "desktop:resources": "bun scripts/prepare-desktop-resources.ts",
    "desktop:sizes:win": "bun scripts/report-desktop-resource-sizes.ts",
    "desktop:pack:win": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop-windows.ps1 -PackageTarget Unpacked",
    "desktop:dist:win": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop-windows.ps1",
    "transcript:migrate": "bun scripts/migrate-transcripts-v2.ts",
    "check:ts-boundary": "bun scripts/check-ts-production-boundary.ts",
    "protocol:generate": "bun packages/foundation/protocol/scripts/generate-types.ts",
    "protocol:check": "bun packages/foundation/protocol/scripts/generate-types.ts --check",
    "verify:migration": "bun run check:ts-boundary && bun run typecheck && bun test packages/foundation/core/test packages/foundation/protocol/test packages/agent/runtime/test apps/gateway/test && bun run test:py-tools && bun run desktop:build",
    "verify:source": "bun run protocol:check && bun run check:ts-boundary && bun run typecheck && bun run test && bun run test:py-tools",
    "verify": "bun run verify:source",
    "verify:platform": "bun run verify:source",
    "verify:platform:win": "bun run release:build",
    "verify:platform:mac": "bun scripts/assert-host-platform.ts darwin && bun run desktop:tools:mac && bun run verify:source && bun scripts/verify-desktop-macos-media.ts",
    "release:build": "bun scripts/release-windows.ts build",
    "release:publish": "bun scripts/release-windows.ts publish",
    "office:prepare": "bun scripts/prepare-office-runtime.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "cos-nodejs-sdk-v5": "3.0.0"
  },
  "patchedDependencies": {
    "@fortune-sheet/core@1.0.4": "config/dependency-patches/@fortune-sheet__core@1.0.4.patch",
    "@fortune-sheet/react@1.0.4": "config/dependency-patches/@fortune-sheet__react@1.0.4.patch",
    "exceljs@4.4.0": "config/dependency-patches/exceljs@4.4.0.patch"
  }
}
