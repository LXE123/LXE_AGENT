#!/usr/bin/env bash
# wt-claim — persistent worktree pool for parallel agent development.
#
#   scripts/wt-claim <task-slug>            claim an idle slot on branch codex/<task-slug>
#   scripts/wt-claim release <task-slug>    release a clean slot, keeping its branch
#   scripts/wt-claim status                 list pool slots
#   scripts/wt-claim refresh-config <task-slug>  replace test config from main, with backup
#
# Slots live in .worktrees/pool-N and are never deleted; dependencies are
# synced in place using bun/uv caches when available.
# Each slot keeps its own .venv — the editable install must point at the
# slot's checkout, so never share or copy a .venv between worktrees.
set -euo pipefail

COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir)"
MAIN_ROOT="$(dirname "$COMMON_DIR")"
POOL_DIR="$MAIN_ROOT/.worktrees"
MAX_SLOTS="${WT_POOL_MAX:-4}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
die() { echo "wt-claim: $*" >&2; exit 1; }

# Exclusive creation works without platform-specific flock utilities.
lock_pool() {
  local diagnostic
  POOL_LOCK="$POOL_DIR/.wt-claim.lock"
  mkdir -p "$POOL_DIR"
  if ! diagnostic="$( (set -o noclobber; echo "$$" > "$POOL_LOCK") 2>&1)"; then
    die "cannot acquire pool lock $POOL_LOCK; another wt-claim may be running, retry after it finishes. $diagnostic"
  fi
  trap 'rm -f "$POOL_LOCK"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

# The claim marker lives NEXT TO the slot (pool-N.claim), never inside it,
# so claiming leaves the worktree perfectly clean.
slot_slug() { cat "$1.claim" 2>/dev/null || true; }

slot_dirty() { [ -n "$(git -C "$1" status --porcelain)" ]; }

slot_branch() { git -C "$1" branch --show-current 2>/dev/null || true; }

sync_deps() {
  local dir="$1" started ended
  started="$(date +%s)"
  (cd "$dir" && bun install --frozen-lockfile >/dev/null)
  (cd "$dir" && uv sync --frozen >/dev/null)
  ended="$(date +%s)"
  echo "deps synced in $((ended - started))s (bun install + uv sync, warm caches)"
}

cmd_status() {
  local i dir slug branch state
  for i in $(seq 1 "$MAX_SLOTS"); do
    dir="$POOL_DIR/pool-$i"
    if [ ! -d "$dir" ]; then
      echo "pool-$i  (not created)"
      continue
    fi
    slug="$(slot_slug "$dir")"
    branch="$(slot_branch "$dir")"
    state="idle"
    [ -n "$slug" ] && state="claimed: $slug"
    slot_dirty "$dir" && state="$state, dirty"
    echo "pool-$i  ${branch:-detached}  $state"
  done
}

cmd_claim() {
  local slug="$1" branch dir i
  [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "task slug must be kebab-case: $slug"
  lock_pool
  branch="codex/$slug"

  # Resume: slug already owns a slot.
  for i in $(seq 1 "$MAX_SLOTS"); do
    dir="$POOL_DIR/pool-$i"
    if [ -d "$dir" ] && [ "$(slot_slug "$dir")" = "$slug" ]; then
      sync_deps "$dir"
      bun "$SCRIPT_DIR/worktree-config.ts" "$MAIN_ROOT" "$dir" init
      echo "resumed pool-$i on $(slot_branch "$dir")"
      echo "$dir"
      return 0
    fi
  done

  # Reattach a retained branch so PR follow-up work resumes at its saved commit.
  local reattach=""
  git -C "$MAIN_ROOT" show-ref --verify --quiet "refs/heads/$branch" && reattach=1

  for i in $(seq 1 "$MAX_SLOTS"); do
    dir="$POOL_DIR/pool-$i"
    if [ ! -d "$dir" ]; then
      git -C "$MAIN_ROOT" worktree add --detach "$dir" main >/dev/null
    elif [ -n "$(slot_slug "$dir")" ]; then
      continue
    elif slot_dirty "$dir"; then
      echo "wt-claim: skipping pool-$i (dirty but unclaimed — inspect manually)" >&2
      continue
    fi
    if [ -n "$reattach" ]; then
      git -C "$dir" checkout --quiet "$branch"
    else
      git -C "$dir" checkout --quiet -b "$branch" main
    fi
    echo "$slug" > "$dir.claim"
    sync_deps "$dir"
    bun "$SCRIPT_DIR/worktree-config.ts" "$MAIN_ROOT" "$dir" init
    echo "$([ -n "$reattach" ] && echo reattached || echo claimed) pool-$i on $branch"
    echo "$dir"
    return 0
  done
  die "no idle slot (max $MAX_SLOTS); release a finished task or raise WT_POOL_MAX"
}

cmd_release() {
  local slug="$1" dir i branch
  lock_pool
  for i in $(seq 1 "$MAX_SLOTS"); do
    dir="$POOL_DIR/pool-$i"
    [ -d "$dir" ] && [ "$(slot_slug "$dir")" = "$slug" ] || continue
    slot_dirty "$dir" && die "pool-$i has uncommitted changes; commit or discard them first"
    branch="$(slot_branch "$dir")"
    git -C "$dir" checkout --quiet --detach main
    rm -f "$dir.claim"
    echo "released pool-$i"
    [ -z "$branch" ] || echo "kept branch $branch"
    return 0
  done
  die "no slot claimed by: $slug"
}

cmd_refresh_config() {
  local slug="$1" dir i
  lock_pool
  for i in $(seq 1 "$MAX_SLOTS"); do
    dir="$POOL_DIR/pool-$i"
    [ -d "$dir" ] && [ "$(slot_slug "$dir")" = "$slug" ] || continue
    bun "$SCRIPT_DIR/worktree-config.ts" "$MAIN_ROOT" "$dir" refresh
    return 0
  done
  die "no slot claimed by: $slug"
}

case "${1:-}" in
  status) cmd_status ;;
  refresh-config) [ -n "${2:-}" ] || die "usage: wt-claim refresh-config <task-slug>"; cmd_refresh_config "$2" ;;
  release) [ -n "${2:-}" ] || die "usage: wt-claim release <task-slug>"; cmd_release "$2" ;;
  "") die "usage: wt-claim <task-slug> | release <task-slug> | refresh-config <task-slug> | status" ;;
  *) cmd_claim "$1" ;;
esac
